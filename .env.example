# --- Supabase (M0) ---
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side ONLY. Never expose to the client, never commit a real value.
# (Engineering Rule #4 / #5)
SUPABASE_SERVICE_ROLE_KEY=

# --- M1 — research + models (server-side only) ---
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# --- M2 — transcription (server-side only; browser gets a short-lived token) ---
DEEPGRAM_API_KEY=

# --- M5 — billing (server-side only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=          # the recurring Price ID for the Pro plan
# Public base URL for Stripe redirect URLs (falls back to the request origin)
NEXT_PUBLIC_SITE_URL=
